@model List<PostBlog>
@{ ViewData["Title"] = "Noticias"; }

<header class="pd-admin__head">
    <div>
        <h1>Noticias</h1>
        <p>Gestioná las noticias que se publican en la sección /noticias.</p>
    </div>
    <div class="pd-admin__actions">
        <a class="pd-btn pd-btn--blue" href="/admin/noticias/nueva">+ Nueva noticia</a>
    </div>
</header>

@if (!Model.Any())
{
    <div class="pd-empty">
        <p>Aún no creaste noticias. <a href="/admin/noticias/nueva">Crear la primera</a>.</p>
    </div>
}
else
{
    <table class="pd-table">
        <thead>
            <tr><th>Título</th><th>Categoría</th><th>Estado</th><th>Publicada</th><th>Vistas</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var n in Model)
        {
            <tr>
                <td><strong>@n.Titulo</strong><br><small>/noticias/@n.Slug</small></td>
                <td>@(n.Categoria?.Nombre ?? "—")</td>
                <td><span class="pd-pill pd-pill--@(n.Estado.ToString().ToLower())">@n.Estado</span></td>
                <td>@(n.FechaPublicacion?.ToString("dd MMM yyyy") ?? "—")</td>
                <td>@n.Vistas</td>
                <td>
                    <a class="pd-link" href="/admin/noticias/editar/@n.Id">Editar</a>
                    <form asp-area="Admin" asp-controller="Noticias" asp-action="Eliminar" asp-route-id="@n.Id" method="post" style="display:inline" onsubmit="return confirm('¿Eliminar definitivamente esta noticia?');">
                        @Html.AntiForgeryToken()
                        <button class="pd-link pd-link--danger" type="submit">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}
